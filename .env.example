# Copy to .env for docker compose. Local development values only.
DATABASE_URL=postgres://postgres:localdb@postgres:5432/gamelogs?sslmode=disable
POSTGRES_PASSWORD=localdb
POSTGRES_DB=gamelogs

# throughput knobs
BATCH_SIZE=500
MAX_BATCH=1000
FLUSH_INTERVAL=1s
ROLLUP_INTERVAL=10s

# host ports
API_PORT=8080
POSTGRES_PORT=5432
